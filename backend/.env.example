PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# SQLite database file (relative to the backend folder)
DB_PATH=./data/currency.db

# ExchangeRate-API (https://www.exchangerate-api.com)
# Leave the key empty to use the free open-access endpoint (https://open.er-api.com).
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_BASE_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_RATE_OPEN_API_BASE_URL=https://open.er-api.com/v6

# Historical time-series provider used for the 30-day trend chart
HISTORICAL_API_BASE_URL=https://api.frankfurter.dev/v1

# Cache lifetimes (minutes)
LATEST_RATES_TTL_MINUTES=60
TREND_TTL_MINUTES=360

# Retention for cached conversion history (rows)
HISTORY_MAX_ROWS=100

# Outbound HTTP timeout (ms)
HTTP_TIMEOUT_MS=8000
